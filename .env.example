# Copy to .env and fill in.

# --- Scoring backend --------------------------------------------------------
# ollama = local, free, private (candidate data never leaves your machine)
# openai = hosted, needs a paid API key
SCREENING_PROVIDER=ollama

# Blank uses the provider default (ollama -> gemma4:latest, openai -> gpt-5).
# Run `python scripts/bench_models.py` to see which local model screens best.
SCREENING_MODEL=

# --- Ollama -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Context window. Ollama's own default is small enough to truncate a long job
# spec + candidate profile, which silently degrades scoring. Raise for long specs.
OLLAMA_NUM_CTX=8192
# Keep the model resident between candidates so a batch doesn't reload it each time.
OLLAMA_KEEP_ALIVE=10m
# Seconds. First call loads the model into memory and can be slow.
OLLAMA_TIMEOUT=300

# --- OpenAI (only used when SCREENING_PROVIDER=openai) -----------------------
OPENAI_API_KEY=
# minimal | low | medium | high -- reasoning depth vs cost.
# Applied only on reasoning models (gpt-5 / o-series); ignored on gpt-4-class models.
SCREENING_EFFORT=medium
# Optional: point at Azure OpenAI or another OpenAI-compatible gateway.
# OPENAI_BASE_URL=

# --- Gemini (automatic fallback for Part 3) ---------------------------------
# Set this and question planning, the live voice call, and grading all fail over
# to Gemini whenever OpenAI is missing, rejected, out of quota, or unreachable.
# Leave blank and Part 3 is OpenAI-only: an OpenAI outage means no interviews.
# This is an API key, not the OAuth credentials used for Forms and Gmail.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Text model, for planning questions and grading transcripts.
# The "-latest" aliases are deliberate. Google retires pinned models for NEW api
# keys while leaving them listed and working for existing ones, so a pinned name
# rots invisibly and 404s the first time you actually need the fallback.
# Pin a version only if you need grading held constant across a hiring round.
GEMINI_MODEL=gemini-flash-latest
# Speech-to-speech model for the call itself.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Kore
# Which provider to try FIRST. The other one is the fallback.
# Set to "gemini" to make Gemini primary without deleting your OpenAI key.
INTERVIEW_PROVIDER=openai

# --- Part 2: interview invitations ------------------------------------------
# TRUE prints messages instead of sending them. Keep it true until you have
# tested a round end to end -- a mistaken blast of invitations is not undoable.
NOTIFY_DRY_RUN=true

DEFAULT_TIMEZONE=Asia/Kolkata

# --- Part 3: AI voice interview ---------------------------------------------
# Realtime speech-to-speech model. -mini is far cheaper per audio minute;
# gpt-realtime-2.1 is more natural at follow-ups. Realtime audio is billed per
# minute in BOTH directions, so a 30-minute interview is not free.
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=alloy
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Writes the question plan before the call and the report after it.
GRADING_MODEL=gpt-5-mini

# The base URL candidates' join links are built from. Must be reachable by them:
# for a real interview this needs to be a public https address, not localhost.
INTERVIEW_BASE_URL=http://127.0.0.1:8000
INTERVIEW_MAX_MINUTES=45

# Proctoring thresholds (seconds of sustained behaviour before it counts).
PROCTOR_LOOK_AWAY_SECONDS=4
PROCTOR_NO_FACE_SECONDS=8
PROCTOR_TAB_HIDDEN_SECONDS=3
# Counted violations tolerated before the call ends itself.
PROCTOR_MAX_VIOLATIONS=4

# Separate database for transcripts, ratings and proctoring events.
INTERVIEW_DATABASE_URL=sqlite:///./data/interviews.db

# --- Database ---------------------------------------------------------------
# SQLite by default. Swap for postgresql+psycopg://user:pass@host/db later.
DATABASE_URL=sqlite:///./data/interview_pipeline.db

# --- Google (OAuth desktop client) ------------------------------------------
GOOGLE_CREDENTIALS_FILE=./secrets/credentials.json
GOOGLE_TOKEN_FILE=./secrets/token.json

# --- Admin access control ---------------------------------------------------
# Leave blank for local-only use. REQUIRED the moment the server is reachable
# from the internet (a tunnel, a deploy): without it, anyone with the URL can
# open /admin and read every candidate's details and send real invitations.
# The server refuses to start publicly unless this is set.
# Candidate interview links keep working either way -- they are authorised by
# the secret token in each personal link, not by this password.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
